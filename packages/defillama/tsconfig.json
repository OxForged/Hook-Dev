{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // "Bundler" rather than NodeNext on purpose: the upstream dimension-adapters
    // repo uses extensionless relative imports (ts-node --transpile-only), and
    // dexs/latch.ts has to be submittable verbatim. vite-node/vitest resolve the
    // same way, so the file that is tested here is the file that ships.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": false,
    "types": ["node"]
  },
  "include": ["dimension-adapters/**/*.ts", "harness/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
