{
  "name": "@latchprotocol/defillama-adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Staging area for Latch Protocol's DefiLlama adapters: TVL (DefiLlama-Adapters) and volume/fees (dimension-adapters), plus a local harness that runs them against a real RPC.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "run:sepolia": "vite-node scripts/run-sepolia.ts",
    "run:robinhood": "vite-node scripts/run-robinhood.ts"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
