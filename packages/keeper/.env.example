# Copy to `.env` beside docker-compose.yml, `chmod 600 .env`. Never commit it.

# The keeper's signing key. OPTIONAL — without it the keeper runs read-only and
# reports what it would do. Only ever needs enough native token for gas.
#
# This key holds NO privileged role. Every function the keeper calls is
# permissionless, so a stolen keeper key buys an attacker nothing they could not
# already do from any address. Do not reuse a deployer or owner key here.
KEEPER_PRIVATE_KEY=

# Which tracked config to mount. Robinhood mainnet:
KEEPER_CONFIG=./keeper.config.robinhood.json

# Seconds between ticks. Minimum 15.
KEEPER_INTERVAL=300
