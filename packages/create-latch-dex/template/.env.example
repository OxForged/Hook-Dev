# Copy to .env.local. Never commit the copy.

# WalletConnect project id. Without one, @latchprotocol/connect omits every
# WalletConnect-backed wallet from the modal rather than offering rows that
# cannot complete a connection.
VITE_WALLETCONNECT_PROJECT_ID=

# A dedicated RPC endpoint, used ahead of the SDK's probed public list.
# A keyed provider embeds its credential in the URL path, which is why this is
# an env var and not a line in latch.config.ts.
VITE_RPC_URL=
