# =============================================================================
# Latch Protocol API — environment
#
# Copy to `.env` and adjust. Every variable is validated at boot by
# src/config/env.ts; anything missing or malformed fails the process start
# rather than surfacing later as a confusing runtime error.
# =============================================================================

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
# Matches the service in docker-compose.yml.
DATABASE_URL=postgresql://latch:latch@localhost:5432/latch?schema=public

# --- Redis -------------------------------------------------------------------
# Used for the response cache AND as the BullMQ backing store. The application
# opens two connections to it (see src/cache/redis.ts) because BullMQ needs a
# connection it can block on.
REDIS_URL=redis://localhost:6379

# --- HTTP --------------------------------------------------------------------
# Comma-separated origins, or * for any. The Vite dev server defaults to 5173.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- caching -----------------------------------------------------------------
# Seconds. 0 disables the response cache (useful when debugging).
CACHE_TTL_SECONDS=30
CACHE_PREFIX=latch:api

# =============================================================================
# Chain data — THE MOCK / LIVE BOUNDARY
#
# No Latch Protocol contract is deployed on any chain, so the ingestion pipeline
# reads fixtures by default. The switch is configuration only; no code changes.
#
#   fixture  always read src/chain/fixtures. THE DEFAULT.
#   rpc      always read eth_getLogs. Fails loudly if a chain is unconfigured.
#   auto     rpc for chains that have BOTH an RPC URL and recorded contract
#            addresses; fixture for the rest. Use this once some chains are live.
# =============================================================================
CHAIN_PROVIDER=fixture

# Per-chain RPC endpoints. Named RPC_URL_<chainId>; read dynamically, so add one
# per chain you deploy to. Leaving them unset is what keeps `auto` on fixtures.
# RPC_URL_8453=https://mainnet.base.org
# RPC_URL_42161=https://arb1.arbitrum.io/rpc
# RPC_URL_1101=https://zkevm-rpc.com

# --- ingestion ---------------------------------------------------------------
# Blocks per eth_getLogs window. Providers cap this differently; 2000 is safe.
INGEST_BLOCK_RANGE=2000
# How often the repeatable poll job runs, in milliseconds.
INGEST_POLL_INTERVAL_MS=30000
# Stay this many blocks behind the head, so reorgs are not ingested.
INGEST_CONFIRMATIONS=5
# Run the ingestion worker inside the API process. Set false and run
# `npm run start:worker` separately to scale them independently.
INGEST_ENABLED=true

# --- background jobs ---------------------------------------------------------
BULLMQ_PREFIX=latch:jobs
WORKER_CONCURRENCY=4

# --- admin -------------------------------------------------------------------
# Shared secret for POST /api/v1/admin/*. When unset those routes are DISABLED
# rather than left open, so forgetting this cannot expose them.
# ADMIN_TOKEN=change-me-to-a-long-random-string

# --- docker compose host ports -----------------------------------------------
# Only used by docker-compose.yml, not by the application. Override when 5432 or
# 6379 are already taken on your machine, and match them in the URLs above.
# POSTGRES_PORT=5442
# REDIS_PORT=6389
