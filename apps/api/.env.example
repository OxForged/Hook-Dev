# =============================================================================
# Latch hosted API — environment. PLACEHOLDERS ONLY.
#
# Copy to `.env` (gitignored; chmod 600 on a server). Validated at boot by
# src/config/env.ts. Never paste a real value into this file.
# =============================================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- local development (compose.dev.yml) ------------------------------------
DATABASE_URL=postgresql://latch:latch-dev-only@127.0.0.1:55432/latch?schema=public
REDIS_URL=redis://127.0.0.1:56379

# --- deploy stack (docker-compose.yml builds DATABASE_URL/REDIS_URL from these)
# Hex only (openssl rand -hex 32) so they are URL-safe.
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# API_KEY_PEPPER=          # REQUIRED in production, >= 32 chars. Rotating it revokes every key.
# LATCH_API_PORT=8093      # published on 127.0.0.1 only

# Express trust proxy. `false` unless a reverse proxy sits in front; then the
# proxy's address or CIDR. `true` is refused (it lets clients forge their IP).
TRUST_PROXY=false

# --- indexer -----------------------------------------------------------------
INDEX_CHAIN_IDS=4663
# Optional keyed RPC, tried before the SDK's public list. Secret if it embeds a key.
# LATCH_RPC_4663=
INDEX_CONFIRMATIONS=100
INDEX_REINDEX_WINDOW=2000
INDEX_MAX_WINDOW=500000
INDEX_MIN_WINDOW=1000
INDEX_POLL_MS=15000
SNAPSHOT_POLL_MS=60000
GOVERNANCE_POLL_MS=600000
FEEDS_POLL_MS=300000

# --- public tier ---------------------------------------------------------------
ANON_RATE_LIMIT_PER_MINUTE=60
KEY_DEFAULT_RATE_LIMIT_PER_MINUTE=600
KEY_DEFAULT_MONTHLY_QUOTA=1000000
REQUEST_TIMEOUT_MS=10000
DEXSCREENER_MAX_BLOCK_RANGE=100000
CACHE_TTL_SECONDS=15

# --- admin panel (OFF by default) ---------------------------------------------
ADMIN_ENABLED=false
# ADMIN_ORIGINS=https://admin.example.invalid
# ADMIN_SIWE_DOMAIN=admin.example.invalid
ADMIN_ROLE_CHAIN_ID=4663
# Comma-separated addresses granted read-only `viewer`. admin/curator come from chain.
# ADMIN_VIEWER_ALLOWLIST=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_ROLE_RECHECK_SECONDS=300
# Only for a local http:// admin UI. Refused in production.
COOKIE_SECURE=true
# eth_call simulation of prepared payloads (read-only; the API holds no key).
ADMIN_SIMULATION_ENABLED=true
# Built operator console, served at /admin when ADMIN_ENABLED=true. The deploy image sets it.
# ADMIN_UI_DIR=../admin/dist

# --- ecosystem listings (public POST /v1/listings) -----------------------------
# Off by default: no public write surface unless asked for. GET /v1/listings (approved only) is always on.
LISTING_SUBMISSIONS_ENABLED=false
LISTING_SUBMIT_PER_HOUR=5
# Cloudflare Turnstile on submissions. When enabled it fails closed. Secret if set.
TURNSTILE_ENABLED=false
# TURNSTILE_SECRET_KEY=
