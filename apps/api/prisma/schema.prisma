// Latch hosted API tier: indexer store, public read API, API keys, admin panel.
//
// RULES THIS SCHEMA ENCODES (see README "Data model"):
//
//   * Raw token units are `Decimal @db.Decimal(78, 0)`: exact integers wide
//     enough for uint256, serialised as decimal strings. Never a float.
//   * Every chain-derived row carries (chainId, blockNumber, txHash, logIndex)
//     and is keyed `${chainId}-${txHash}-${logIndex}`. `blockNumber` is the L2
//     LOG clock (eth_getLogs). A column holding a CONTRACT-stored block number
//     (LaunchpadKit.startBlock, RevShareHook.effectiveBlock) is named
//     `*ContractBlock` and is on the contract clock (Ethereum L1 on Robinhood).
//   * Reorg safety is by RANGE REPLACEMENT: an index pass deletes every
//     log-derived row in [fromBlock, toBlock] for the chain and re-inserts what
//     the chain returns, in one transaction with the checkpoint advance. So a
//     log-derived table must be deletable by (chainId, blockNumber) and must not
//     carry counters that a replay would double.
//   * Snapshot tables (state read by the worker, not from logs) record the block
//     they were read at and when.
//   * No USD is stored for anything that is not an oracle read. USD columns carry
//     their source and timestamp beside them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

enum PoolType {
  CL
  BIN
}

enum LiquidityEventKind {
  /// CLPoolManager.ModifyLiquidity
  MODIFY
  /// BinPoolManager.Mint (per-bin amounts kept packed, not decoded)
  MINT
  /// BinPoolManager.Burn (per-bin amounts kept packed, not decoded)
  BURN
}

enum PoolFeeUpdateKind {
  /// ProtocolFees.ProtocolFeeUpdated(PoolId, uint24) on a pool manager
  PROTOCOL_FEE
  /// DynamicLPFeeUpdated(PoolId, uint24) on a pool manager
  DYNAMIC_LP_FEE
}

enum FeeCollectionVia {
  /// LatchProtocolFeeControllerV2.collect (owner-only, recipient chosen per call)
  COLLECT
  /// LatchProtocolFeeControllerV2.sweep (permissionless, recipient = stored treasury)
  SWEEP
  /// The transaction's input did not start with either selector (e.g. a Safe
  /// or timelock executing it as an inner call).
  INNER_CALL
}

enum RunKind {
  INDEX
  SNAPSHOT
  GOVERNANCE_SNAPSHOT
  FEEDS
  USAGE_FLUSH
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationStatus {
  /// Log sum equals the on-chain counter at the same block.
  VERIFIED
  /// Log sum differs from the counter. Revenue built on it is NOT served as reconciled.
  MISMATCH
  /// The contract has no counter to check against (it reverted: e.g. a hook predating totalTaken).
  UNAVAILABLE
  /// The check could not run (RPC failure). Says nothing about the data.
  ERROR
}

/// Where a revenue ledger entry came from. The last three are extension points:
/// defined so an admin panel can render them, not yet written by the indexer.
enum RevenueSource {
  /// LatchProtocolFeeControllerV2 ProtocolFeesCollected via collect()
  PROTOCOL_FEE_COLLECTED
  /// LatchProtocolFeeControllerV2 ProtocolFeesCollected via sweep()
  PROTOCOL_FEE_SWEPT
  /// RevShareHook Claimed(...) where the beneficiary is a protocol address (governance Safe)
  REVSHARE_PROTOCOL_CLAIM
  /// Not indexed yet: LatchLPLocker protocol-share claims
  LP_LOCKER_PROTOCOL_CLAIM
  /// Not indexed yet: LatchLPLocker integrator-share claims
  LP_LOCKER_INTEGRATOR_CLAIM
  /// Not indexed yet: LaunchpadKit v2 flat launch fee
  KIT_LAUNCH_FEE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum ListingKind {
  LATCH
  LAUNCH
  LAUNCHPAD
  TOKEN
  /// An ecosystem directory entry (apps/web/src/routes/ecosystem): a third-party
  /// project, submitted through the public POST /v1/listings.
  PROJECT
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  /// A moderator asked the submitter for changes. Terminal for this row: the
  /// submitter re-submits, which creates a new row.
  CHANGES_REQUESTED
}

enum ProposalStatus {
  /// The read failed. Never rendered as NONE.
  UNKNOWN
  NONE
  QUEUED
  ARMED
  EXPIRED
}

// ===========================================================================
// Chains and indexer bookkeeping
// ===========================================================================

/// One chain Latch is deployed on. Synced from `@latchprotocol/sdk` deployments
/// by the worker at start-up; never hand-edited.
model Chain {
  id                      Int      @id
  key                     String   @unique
  name                    String
  isMainnet               Boolean
  /// L2 log clock. Where index passes start on a cold checkpoint.
  deployedAtBlock         BigInt
  /// "parent-l1" | "native" (SDK ContractBlockClock)
  contractBlockClock      String
  contractBlockTimeCentis Int
  enabled                 Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  @@map("chains")
}

/// Resume point for one chain. Advanced in the SAME transaction as the rows of
/// the window it covers, so it can never point past data that was not written.
model IndexerCheckpoint {
  chainId                   Int       @id
  /// Last L2 block whose logs are fully written. Inclusive.
  lastIndexedBlock          BigInt
  /// Hash of `lastIndexedBlock` as the chain reported it. Re-read every pass; a
  /// different answer is a reorg deeper than the confirmation depth.
  lastIndexedBlockHash      String
  lastIndexedBlockTimestamp DateTime
  /// sha256 of the sorted watched-address set. A change (an SDK redeploy entry)
  /// forces a re-index from `Chain.deployedAtBlock`.
  addressSetHash            String
  /// Head as observed by the worker (NOT per request). Health = head - indexed.
  headBlock                 BigInt
  headObservedAt            DateTime
  /// Last contract-clock reading (SDK readContractClock). On Robinhood this is the
  /// Ethereum L1 block number that contracts see as block.number.
  contractBlockNumber       BigInt?
  contractClockMethod       String?
  contractClockRpcBlock     BigInt?
  contractClockTimestamp    DateTime?
  contractClockReadAt       DateTime?
  updatedAt                 DateTime  @updatedAt

  @@map("indexer_checkpoints")
}

model IndexerRun {
  id           String    @id @default(cuid())
  chainId      Int
  kind         RunKind
  status       RunStatus @default(RUNNING)
  fromBlock    BigInt?
  toBlock      BigInt?
  logsFetched  Int       @default(0)
  rowsWritten  Int       @default(0)
  /// Host only, never the URL (RPC URLs can embed keys).
  endpointHost String?
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([chainId, kind, startedAt(sort: Desc)])
  @@map("indexer_runs")
}

model ReorgEvent {
  id           String   @id @default(cuid())
  chainId      Int
  atBlock      BigInt
  storedHash   String
  observedHash String
  rewoundTo    BigInt
  detectedAt   DateTime @default(now())

  @@index([chainId, detectedAt(sort: Desc)])
  @@map("reorg_events")
}

// ===========================================================================
// Log-derived rows (range-replaced on every pass; see header)
// ===========================================================================

/// Initialize on a pool manager. Pool id = keccak256(PoolKey), which includes the
/// manager, so (chainId, poolId) is unique.
model Pool {
  id             String   @id
  chainId        Int
  poolId         String
  poolType       PoolType
  poolManager    String
  currency0      String
  currency1      String
  hooks          String
  /// Raw pool-key fee (0x800000 = dynamic).
  fee            Int
  parameters     String
  hookBitmap     Int
  tickSpacing    Int?
  binStep        Int?
  initSqrtPriceX96 Decimal? @db.Decimal(78, 0)
  initTick       Int?
  initActiveId   Int?

  blockNumber    BigInt
  blockTimestamp DateTime
  txHash         String
  txIndex        Int
  logIndex       Int

  swaps     Swap[]
  liquidity LiquidityEvent[]
  state     PoolState?

  @@unique([chainId, poolId])
  @@index([chainId, blockNumber])
  @@index([chainId, currency0])
  @@index([chainId, currency1])
  @@index([chainId, hooks])
  @@map("pools")
}

/// Swap on either pool manager.
///
/// SIGN CONVENTION: amount0/amount1 are the CALLER's balance delta. Negative =
/// paid in. Verified on 4663, tx 0x68286e9b…629a (amount0 = -1e18 while exactly
/// 1e18 of currency0 entered the Vault). The inherited core docstring says
/// "pool's balance" and is wrong.
model Swap {
  id             String   @id
  chainId        Int
  poolRowId      String
  poolId         String
  poolType       PoolType
  /// Caller of the pool manager — usually a router, not the trader.
  sender         String
  /// Outer transaction `from` — the account that signed. What DexScreener calls `maker`.
  txFrom         String?
  amount0        Decimal  @db.Decimal(78, 0)
  amount1        Decimal  @db.Decimal(78, 0)
  /// amount0 < 0: currency0 was paid in.
  zeroForOne     Boolean
  tokenIn        String
  tokenOut       String
  amountIn       Decimal  @db.Decimal(78, 0)
  amountOut      Decimal  @db.Decimal(78, 0)
  /// Total swap fee rate the swap carried, pips.
  fee            Int
  /// Single-direction protocol fee the swap carried, pips.
  protocolFee    Int
  /// amountIn * fee / 1e6, floored. Input-token units.
  feeTotal       Decimal  @db.Decimal(78, 0)
  /// amountIn * protocolFee / 1e6, floored.
  feeProtocol    Decimal  @db.Decimal(78, 0)
  /// feeTotal - feeProtocol, floored at 0.
  feeLp          Decimal  @db.Decimal(78, 0)
  sqrtPriceX96   Decimal? @db.Decimal(78, 0)
  liquidity      Decimal? @db.Decimal(78, 0)
  tick           Int?
  activeId       Int?

  blockNumber    BigInt
  blockTimestamp DateTime
  txHash         String
  txIndex        Int
  logIndex       Int
  contract       String

  pool Pool @relation(fields: [poolRowId], references: [id], onDelete: Cascade)

  @@index([poolRowId, blockNumber, logIndex])
  @@index([chainId, blockNumber])
  @@index([chainId, blockTimestamp])
  @@index([chainId, tokenIn, blockTimestamp])
  @@index([txHash])
  @@map("swaps")
}

model LiquidityEvent {
  id             String             @id
  chainId        Int
  poolRowId      String
  poolId         String
  kind           LiquidityEventKind
  sender         String
  salt           String
  tickLower      Int?
  tickUpper      Int?
  liquidityDelta Decimal?           @db.Decimal(78, 0)
  /// Bin ids as decimal strings.
  binIds         String[]           @default([])
  /// PackedUint128Math words, verbatim. Not decoded (layout not verified).
  packedAmounts  String[]           @default([])

  blockNumber    BigInt
  blockTimestamp DateTime
  txHash         String
  txIndex        Int
  logIndex       Int
  contract       String

  pool Pool @relation(fields: [poolRowId], references: [id], onDelete: Cascade)

  @@index([poolRowId, blockNumber, logIndex])
  @@index([chainId, blockNumber])
  @@map("liquidity_events")
}

model PoolFeeUpdate {
  id             String            @id
  chainId        Int
  poolId         String
  kind           PoolFeeUpdateKind
  value          Int

  blockNumber    BigInt
  blockTimestamp DateTime
  txHash         String
  txIndex        Int
  logIndex       Int
  contract       String

  @@index([chainId, poolId, blockNumber])
  @@index([chainId, blockNumber])
  @@map("pool_fee_updates")
}

/// RevShareHook.RevShareTaken, ONLY from Latch's own RevShareHook deployments
/// (SDK address book + the hook the SDK reference pool is bound to). A third
/// party can emit the same signature with any numbers it likes.
model RevShareTake {
  id              String   @id
  chainId         Int
  hook            String
  poolId          String
  currency        String
  lpDonated       Decimal  @db.Decimal(78, 0)
  toBeneficiaries Decimal  @db.Decimal(78, 0)
  toDistributor   Decimal  @db.Decimal(78, 0)

  blockNumber    BigInt
  blockTimestamp DateTime
  txHash         String
  txIndex        Int
  logIndex       Int

  @@index([chainId, hook, poolId, currency])
  @@index([chainId, blockNumber])
  @@index([chainId, blockTimestamp])
  @@map("revshare_takes")
}

/// RevShareHook.Claimed — a beneficiary withdrawing its credited share.
model RevShareClaim {
  id          String   @id
  chainId     Int
  hook        String
  beneficiary String
  currency    String
  to          String
  amount      Decimal  @db.Decimal(78, 0)

  blockNumber    BigInt
  blockTimestamp DateTime
  txHash         String
  txIndex        Int
  logIndex       Int

  @@index([chainId, beneficiary])
  @@index([chainId, blockNumber])
  @@map("revshare_claims")
}

/// LatchProtocolFeeControllerV2.ProtocolFeesCollected.
model ProtocolFeeCollection {
  id          String           @id
  chainId     Int
  controller  String
  poolManager String
  currency    String
  recipient   String
  amount      Decimal          @db.Decimal(78, 0)
  via         FeeCollectionVia

  blockNumber    BigInt
  blockTimestamp DateTime
  txHash         String
  txIndex        Int
  logIndex       Int

  @@index([chainId, currency])
  @@index([chainId, blockNumber])
  @@map("protocol_fee_collections")
}

/// LaunchpadKit.LaunchCreated.
model Launch {
  id                    String   @id
  chainId               Int
  kit                   String
  poolId                String
  launchToken           String
  quoteToken            String
  operator              String
  /// CONTRACT CLOCK (block.number as the kit saw it; Ethereum L1 on Robinhood).
  startContractBlock    BigInt
  decayContractBlocks   Int
  initialFeeBips        Int
  finalFeeBips          Int
  maxBuyPerTx           Decimal  @db.Decimal(78, 0)
  launchTokenIsCurrency0 Boolean
  preset                Int

  blockNumber    BigInt
  blockTimestamp DateTime
  txHash         String
  txIndex        Int
  logIndex       Int

  @@unique([chainId, kit, poolId])
  @@index([chainId, launchToken])
  @@index([chainId, blockNumber])
  @@map("launches")
}

/// Every other indexed event, decoded, with all integers as decimal strings:
/// LaunchSeeded, LaunchReconfigured, LatchRegistry listing events, and
/// LatchLaunchRegistry launch events. `subject` is the pool id or hook address.
model ContractEvent {
  id             String   @id
  chainId        Int
  /// SDK address-book key of the emitter, e.g. "launchpadKit", "registry".
  contractKey    String
  contract       String
  eventName      String
  subject        String?
  args           Json

  blockNumber    BigInt
  blockTimestamp DateTime
  txHash         String
  txIndex        Int
  logIndex       Int

  @@index([chainId, contractKey, eventName])
  @@index([chainId, subject])
  @@index([chainId, blockNumber])
  @@map("contract_events")
}

/// TimelockController CallScheduled / CallExecuted / Cancelled / CallSalt /
/// MinDelayChange on the SDK timelocks, decoded to target and selector.
model TimelockEvent {
  id                String   @id
  chainId           Int
  timelock          String
  /// "custody" | "policy"
  tier              String
  eventName         String
  operationId       String?
  callIndex         Int?
  target            String?
  value             Decimal? @db.Decimal(78, 0)
  data              String?
  selector          String?
  /// Human signature when the selector is one we know.
  functionSignature String?
  predecessor       String?
  /// CallSalt's salt (on the CallSalt row). Needed to build execute(...) for a queued
  /// operation; the operation id commits to it, so it is verified by re-hashing.
  salt              String?
  delaySeconds      BigInt?
  /// Non-null when the call is on the CLAUDE.md do-not-queue list.
  hazard            String?
  hazardNote        String?

  blockNumber    BigInt
  blockTimestamp DateTime
  txHash         String
  txIndex        Int
  logIndex       Int

  @@index([chainId, operationId])
  @@index([chainId, hazard])
  @@index([chainId, blockNumber])
  @@map("timelock_events")
}

/// Unified revenue ledger for the admin panel. Written by the indexer alongside
/// the source row (so it is range-replaced with it). Flows only; accrued-but-
/// uncollected balances are snapshots (ProtocolFeeAccrualSnapshot).
model RevenueLedgerEntry {
  id             String        @id
  chainId        Int
  source         RevenueSource
  token          String
  amount         Decimal       @db.Decimal(78, 0)
  counterparty   String?
  contract       String
  poolId         String?
  /// Oracle-priced value at the time of pricing. Null unless a real feed exists.
  usdValue       String?
  usdSource      String?
  usdPricedAt    DateTime?

  blockNumber    BigInt
  blockTimestamp DateTime
  txHash         String
  logIndex       Int

  @@index([chainId, source, blockTimestamp])
  @@index([chainId, token])
  @@index([chainId, blockNumber])
  @@map("revenue_ledger")
}

// ===========================================================================
// Snapshots (state read by the worker, pinned to a block)
// ===========================================================================

model Token {
  id             String   @id
  chainId        Int
  address        String
  symbol         String?
  name           String?
  decimals       Int?
  totalSupply    Decimal? @db.Decimal(78, 0)
  inAddressBook  Boolean  @default(false)
  isTestToken    Boolean?
  /// Robinhood stock tokens: `uiMultiplier()` (1e18 = 1 share per token). Null
  /// when the token does not answer it.
  uiMultiplier   Decimal? @db.Decimal(78, 0)
  /// Robinhood stock tokens: `tokenPaused()`. Null when the token does not answer it.
  tokenPaused    Boolean?
  readAtBlock    BigInt?
  readAt         DateTime?
  readError      String?

  @@unique([chainId, address])
  @@map("tokens")
}

/// Issuer-controlled state of a stock token that sits in a Latch pool, read by
/// the worker every snapshot pass. A row is written when a value CHANGES (or
/// hourly), so the table is a change history, not a poll log.
model StockTokenObservation {
  id           String   @id @default(cuid())
  chainId      Int
  token        String
  tokenPaused  Boolean?
  uiMultiplier Decimal? @db.Decimal(78, 0)
  /// True when tokenPaused or uiMultiplier differs from the previous row.
  changed      Boolean  @default(false)
  previousPaused       Boolean?
  previousUiMultiplier Decimal? @db.Decimal(78, 0)
  readAtBlock  BigInt
  readAt       DateTime @default(now())
  readError    String?

  @@index([chainId, token, readAtBlock(sort: Desc)])
  @@index([chainId, changed, readAt(sort: Desc)])
  @@map("stock_token_observations")
}

model PoolState {
  poolRowId    String   @id
  chainId      Int
  sqrtPriceX96 Decimal? @db.Decimal(78, 0)
  tick         Int?
  liquidity    Decimal? @db.Decimal(78, 0)
  activeId     Int?
  protocolFee  Int?
  lpFee        Int?
  readAtBlock  BigInt
  readAt       DateTime
  readError    String?

  pool Pool @relation(fields: [poolRowId], references: [id], onDelete: Cascade)

  @@map("pool_states")
}

/// `protocolFeesAccrued(currency)` on a pool manager: charged, not yet collected.
model ProtocolFeeAccrualSnapshot {
  id          String   @id @default(cuid())
  chainId     Int
  poolManager String
  currency    String
  amount      Decimal  @db.Decimal(78, 0)
  readAtBlock BigInt
  readAt      DateTime @default(now())

  @@index([chainId, poolManager, currency, readAtBlock(sort: Desc)])
  @@map("protocol_fee_accrual_snapshots")
}

/// One Chainlink read. USD for a token is derived at read time from the latest
/// row for its mapped feed and the token's uiMultiplier, and carries both.
model FeedObservation {
  id                 String   @id @default(cuid())
  chainId            Int
  label              String
  proxy              String
  description        String?
  roundId            Decimal? @db.Decimal(78, 0)
  answer             Decimal? @db.Decimal(78, 0)
  decimals           Int?
  feedUpdatedAt      DateTime?
  readAtBlock        BigInt
  blockTimestamp     DateTime
  stalenessSeconds   Int?
  heartbeatSeconds   Int
  heartbeatViolation Boolean?
  error              String?
  readAt             DateTime @default(now())

  @@index([chainId, proxy, readAtBlock(sort: Desc)])
  @@map("feed_observations")
}

/// Log sum vs on-chain counter. Current state per (chain, kind, subject).
model Reconciliation {
  id        String               @id
  chainId   Int
  kind      String
  subject   String
  atBlock   BigInt
  expected  String?
  observed  String?
  status    ReconciliationStatus
  detail    String?
  checkedAt DateTime             @default(now())

  @@index([chainId, kind])
  @@map("reconciliations")
}

/// owner() / pendingOwner() / hasRole() of a deployed contract vs the CLAUDE.md
/// Ownership table. Current state per check.
model OwnershipSnapshot {
  id              String   @id
  chainId         Int
  contractKey     String
  address         String
  check           String
  observed        String?
  expectedTier    String
  expectedAddress String?
  matches         Boolean?
  readError       String?
  readAtBlock     BigInt
  readAt          DateTime

  @@index([chainId, matches])
  @@map("ownership_snapshots")
}

/// RevShareHook.getPendingConfig, decoded by return length, judged on the
/// CONTRACT clock. ARMED = matured and applicable by anyone right now.
model PendingConfigHazard {
  id                  String         @id
  chainId             Int
  hook                String
  poolId              String
  /// "legacy" (7 words, no expiry) | "current" (8 words)
  shape               String
  effectiveContractBlock BigInt
  expiryContractBlock BigInt?
  params              Json
  status              ProposalStatus
  contractBlockNumber BigInt
  contractClockMethod String
  readAtBlock         BigInt
  readAt              DateTime
  readError           String?

  @@index([chainId, status])
  @@map("pending_config_hazards")
}

model OpsBalance {
  id          String   @id
  chainId     Int
  label       String
  address     String
  purpose     String
  balanceWei  Decimal  @db.Decimal(78, 0)
  /// WARN threshold (kept under its original name). gasUnits x gasPrice x warnActions.
  minWei      Decimal? @db.Decimal(78, 0)
  belowMin    Boolean?
  /// CRITICAL threshold: gasUnits x gasPrice x criticalActions.
  criticalWei Decimal? @db.Decimal(78, 0)
  /// Gas price the thresholds were computed with, and where it came from
  /// ("eth_gasPrice@<block>" or "config reference").
  gasPriceWei    Decimal? @db.Decimal(78, 0)
  gasPriceSource String?
  /// How many of the account's action this balance pays for at gasPriceWei.
  actionsAffordable Decimal? @db.Decimal(78, 0)
  /// "CRITICAL" | "WARN" | "OK" | null (no budget configured)
  severity    String?
  /// The config's gas-cost rationale, copied so a reader sees why the threshold is what it is.
  rationale   String?
  readAtBlock BigInt
  readAt      DateTime

  @@map("ops_balances")
}

// ===========================================================================
// Ecosystem listing moderation
// ===========================================================================

model ListingSubmission {
  id               String        @id @default(cuid())
  /// Null for a PROJECT submission, which names its chains in `chains`.
  chainId          Int?
  kind             ListingKind
  subjectAddress   String?
  poolId           String?
  name             String
  description      String
  websiteUrl       String?
  /// ListingAsset.id. Never an inline blob.
  iconAssetRef     String?
  /// PRIVATE. Never serialised by a public route.
  contactPrivate   String?
  submittedBy      String?
  /// Ecosystem fields, limits mirrored from apps/web ecosystem.ts LISTING_LIMITS.
  category         String?
  categoryOther    String?
  sourceUrl        String?
  /// LatchKind values ("launch-guard", "rev-share", ...).
  uses             String[]      @default([])
  ownLatch         String?
  chains           Int[]         @default([])
  iconSourceUrl    String?
  /// sha256(pepper, ip) — for abuse review; the IP itself is not stored.
  submitterIpHash  String?
  turnstileVerified Boolean      @default(false)
  status           ListingStatus @default(PENDING)
  reviewer         String?
  reviewNotes      String?
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("listing_submissions")
}

/// A listing icon AFTER server-side processing: PNG re-chunked to critical
/// chunks only, SVG parsed against an allowlist and re-serialised. The bytes
/// the uploader sent are never stored or served.
model ListingAsset {
  id          String   @id @default(cuid())
  /// "image/png" | "image/svg+xml"
  contentType String
  bytes       Bytes
  byteLength  Int
  width       Int?
  height      Int?
  sha256      String
  createdAt   DateTime @default(now())

  @@index([sha256])
  @@map("listing_assets")
}

// ===========================================================================
// Admin auth (SIWE) and audit
// ===========================================================================

model AdminNonce {
  nonce      String    @id
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?

  @@index([expiresAt])
  @@map("admin_nonces")
}

model AdminSession {
  /// sha256 of the session token. The token itself lives only in the cookie.
  id              String    @id
  address         String
  roles           String[]
  /// sha256 of the CSRF token handed to the client once.
  csrfHash        String
  chainId         Int
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  lastRoleCheckAt DateTime
  revokedAt       DateTime?
  ip              String?
  userAgent       String?

  @@index([address])
  @@map("admin_sessions")
}

/// Written on every admin mutation (sign-in and sign-out included).
model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  actorRoles String[]
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  requestId  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actor])
  @@map("audit_log")
}

// ===========================================================================
// API keys, usage, and the billing attachment point
// ===========================================================================

/// A customer. Billing is out of scope; `billingProvider`/`billingCustomerId`
/// are where a billing system attaches.
model ApiAccount {
  id                String   @id @default(cuid())
  name              String
  /// Private contact. Never returned by a public route.
  contact           String?
  plan              String   @default("free")
  billingProvider   String?
  billingCustomerId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  keys ApiKey[]

  @@unique([billingProvider, billingCustomerId])
  @@map("api_accounts")
}

model ApiKey {
  id                 String       @id @default(cuid())
  accountId          String
  name               String
  /// Public, non-secret lookup prefix shown in listings (e.g. "latchk_3f9a…").
  prefix             String       @unique
  /// HMAC-SHA256(API_KEY_PEPPER, secret). The secret is never stored.
  secretHash         String       @unique
  scopes             String[]
  rateLimitPerMinute Int
  monthlyQuota       Int
  status             ApiKeyStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedReason      String?
  lastUsedAt         DateTime?

  account ApiAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  usage   ApiUsageMonthly[]

  @@index([accountId])
  @@map("api_keys")
}

/// Request counts per key per UTC month. Redis is authoritative for the current
/// month; the flush job SETs (never increments) this row from it.
model ApiUsageMonthly {
  keyId     String
  period    String
  requests  BigInt   @default(0)
  flushedAt DateTime @default(now())

  key ApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([keyId, period])
  @@map("api_usage_monthly")
}
